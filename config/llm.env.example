# Template for live model testing. Contains NO secrets.
#
# Do not copy this into the repo with a real key in it. Instead create the file
# outside the project, for example:
#
#   mkdir -p ~/.config/puzzlesolver
#   cp config/llm.env.example ~/.config/puzzlesolver/env
#   chmod 600 ~/.config/puzzlesolver/env
#   $EDITOR ~/.config/puzzlesolver/env
#
# Then source it for a single command, so the key never lands in the project
# directory, in shell history, or in this session's transcript:
#
#   set -a; . ~/.config/puzzlesolver/env; set +a
#   npm run test:live
#
# Everything below is read from the environment by src/cli.js and
# scripts/live-eval.js. The running service reads its base URL, models and
# auto-router policy from config.toml ([solver] llm_base_url, llm_text_model,
# llm_vision_model, cost_tier, allowed_models, excluded_models) and only
# LLM_API_KEY from the environment. Nothing is written to disk by the app.
#
# ===========================================================================
# RECOMMENDED: auto-route the text tier, pin a chosen model for the vision tier
# ===========================================================================
#
# Why the split:
#   text tier  - reading a transcript and emitting JSON is easy work, so letting
#                the router pick per request is fine and cheap.
#   vision tier - runs ONLY when OCR failed, so it is the one tier where model
#                choice matters most. Left to a router it also inherits the
#                cheapest cost band by default. Choose it deliberately.
#
# Both variables accept a comma-separated list, which becomes an ordered fallback
# chain (max 3): the first entry is tried first, the rest only on error, rate limit
# or downtime.

LLM_API_KEY=
LLM_BASE_URL=https://openrouter.ai/api/v1

# Auto-route the solver tier.
LLM_TEXT_MODEL=openrouter/auto

# Cost band for the auto router: low | medium | high | xhigh | max.
# Unset behaves as roughly "low".
# The service equivalent is [solver] cost_tier in config.toml. Precedence for the
# CLI and live-eval is a flag, then this environment variable, then the config file.
LLM_COST_TIER=medium

# Restrict which models the auto router may pick (wildcard patterns).
# Applies to auto-routed slugs only; pinned models ignore it.
#   openai/*   google/gemini-*   */claude-*
# The service equivalent is [solver] allowed_models.
LLM_ALLOWED_MODELS=

# Never route to these; applied after the allow list.
# The service equivalent is [solver] excluded_models.
LLM_EXCLUDED_MODELS=

# A deliberately chosen vision model.
#
# The `~` prefix means a rolling alias that always redirects to the latest model in
# its family, so it does not go stale the way a dated version does. All three below
# accept images and support structured outputs. Pick one, or name an exact version.
#
#   ~google/gemini-flash-latest      cheap, strong at OCR-style reading
#   ~anthropic/claude-sonnet-latest  stronger, pricier
#   ~openai/gpt-mini-latest          cheap
#
# QUOTE THE VALUE. Bash performs tilde expansion on assignments, so an unquoted
# leading ~ is expanded against local usernames. `~google/...` happens to survive
# (no such user) but `~root/x` silently becomes `/root/x`. Quoting stops that.
#
# To list every vision-capable rolling alias yourself:
#   curl -s https://openrouter.ai/api/v1/models | node -e "
#   let s='';process.stdin.on('data',d=>s+=d).on('end',()=>{
#     JSON.parse(s).data.filter(m=>m.id.startsWith('~')&&
#       m.architecture?.input_modalities?.includes('image'))
#       .forEach(m=>console.log(m.id,'->',m.alias_target?.slug));});"
LLM_VISION_MODEL="~google/gemini-flash-latest"

# Optional: a fallback chain instead of a single model.
# LLM_VISION_MODEL="~google/gemini-flash-latest,~anthropic/claude-sonnet-latest"

# ===========================================================================
# ALTERNATIVE: OpenAI directly
# ===========================================================================
# LLM_API_KEY=
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_TEXT_MODEL=gpt-4o-mini
# LLM_VISION_MODEL=gpt-4o

# ===========================================================================
# ALTERNATIVE: a local OpenAI-compatible server (no key needed; set any value)
# ===========================================================================
# LLM_API_KEY=local
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_TEXT_MODEL=qwen2.5:7b
# LLM_VISION_MODEL=qwen2.5vl:7b
