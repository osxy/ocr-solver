{
  "name": "puzzlesolver",
  "version": "0.45.2",
  "private": true,
  "type": "module",
  "description": "Reads Pushbullet puzzle images, solves them, replies with the answer",
  "engines": {
    "node": ">=22.13.0"
  },
  "bin": {
    "puzzlesolver": "src/cli.js"
  },
  "dependencies": {
    "@tesseract.js-data/nld": "^1.0.0",
    "node-notifier": "^10.0.1",
    "sharp": "^0.35.5",
    "smol-toml": "^1.9.1",
    "systray2": "^2.1.4",
    "tesseract.js": "^7.0.0"
  },
  "scripts": {
    "test": "node --test --test-timeout=60000 \"tests/**/*.test.js\"",
    "test:unit": "node --test tests/numbers.test.js tests/transcript.test.js tests/puzzle.test.js tests/validate.test.js tests/model-client.test.js tests/reason.test.js tests/pipeline-model.test.js tests/state.test.js",
    "test:corpus": "node --test tests/corpus.test.js",
    "accuracy": "node src/accuracy-cli.js",
    "screenshots": "node scripts/screenshots.mjs",
    "corpus:generate": "node scripts/generate-corpus.js",
    "corpus:verify": "node scripts/generate-corpus.js --verify-only",
    "solve": "node src/cli.js",
    "tune": "node scripts/tune-preprocessing.js",
    "test:live": "node --test tests/live-model.test.js",
    "prepare": "git config core.hooksPath scripts/git-hooks 2>/dev/null || true"
  }
}
